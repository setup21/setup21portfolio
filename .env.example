PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<new-cluster-host>/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
MONGO_DB_NAME=setup21portfolio
# Optional local DNS override for SRV lookup failures; leave unset in Azure App Service.
MONGO_DNS_SERVERS=8.8.8.8
JWT_SECRET=<generate-a-long-random-secret>
SWAGGER_USER=<docs-user>
SWAGGER_PASSWORD=<docs-password>
# Web app status endpoints
MAINTENANCE=false
SERVER_VERSION=1.0.0
